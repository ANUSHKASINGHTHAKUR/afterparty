# Copy this file to ".env" and fill it in. (START_HERE.bat does this for you on Windows.)
# Never share the .env file with anyone.

ADMIN_USERNAME=organiser
ADMIN_PASSWORD=replace-with-a-strong-password-10+characters

# Leave empty: a secret key is created automatically and saved in the data folder.
SECRET_KEY=

# Set to 1 ONLY when the site is on https:// (the public website). Keep 0 for local testing.
COOKIE_SECURE=0

# Name that attendees should see in their UPI app (taken from the QR you supplied). Please confirm it is right.
PAYEE_NAME=DEVANSH TOMAR

# Set to 0 to close registrations.
REGISTRATION_OPEN=1

# Set to 1 when the host puts a proxy in front of the app (Render, Railway, Fly, nginx). Not needed on PythonAnywhere.
TRUST_PROXY=0

# Where data is kept. Defaults are fine. On a host, point these to a PERSISTENT disk.
# DATABASE_PATH=data/afterparty.sqlite3
# UPLOAD_DIR=data/payment-proofs
# TICKET_DIR=data/tickets
